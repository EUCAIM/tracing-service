FROM postgres:18-alpine

COPY ./db/init.sh /opt/tracing/
COPY ./db/v2.sql /opt/tracing/

WORKDIR /opt/tracing

RUN apk add yq \
    && addgroup --gid 1000 tracing \
	&& adduser -D -u 1000 -G tracing tracing \
	&& chown -R 1000:1000 /opt/tracing

USER tracing

ENV SETTINGS_PATH=/opt/tracing/settings.yml
ENV TRACING_DB_ADMIN_NAME=admin
ENV TRACING_DB_ADMIN_PASSWORD_PATH=/opt/tracing/TRACING_DB_ADMIN_PASSWORD
ENV SETTINGS_SECRET_PATH=/opt/tracing/settings_secret.yml


ENTRYPOINT ["sh", "-c"]
CMD ["/opt/tracing/init.sh -h \"$(yq -r '.database.host' $SETTINGS_PATH)\" -p \"$(yq -r '.database.port' $SETTINGS_PATH)\" -a \"$TRACING_DB_ADMIN_NAME\" -m \"$(cat $TRACING_DB_ADMIN_PASSWORD_PATH)\" -u \"$(yq -r '.database.user' $SETTINGS_PATH)\" -s \"$(yq -r '.database_password' $SETTINGS_SECRET_PATH)\" -d \"$(yq -r '.database.name' $SETTINGS_PATH)\" "]